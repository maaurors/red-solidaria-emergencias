<mxfile host="app.diagrams.net"><diagram id="canvas" name="Canvas de Negocio"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="MODELO DE NEGOCIO CANVAS - Red Solidaria de Emergencias" style="text;html=1;align=center;fontSize=20;fontStyle=1;fontColor=#2C3E70;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="40" as="geometry"/></mxCell><mxCell id="b8" value="8. SOCIOS CLAVE&#10;&#10;SENAPRED&#10;Municipalidades&#10;Cruz Roja y Bomberos&#10;Retail y logistica&#10;(transporte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8863C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="220" height="440" as="geometry"/></mxCell><mxCell id="b7" value="7. ACTIVIDADES CLAVE&#10;&#10;Validacion de albergues&#10;Gestion de catalogo de items&#10;Asignacion donacion a necesidad&#10;Coordinacion de turnos&#10;Deficit en tiempo real" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5FBF7A;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="220" height="220" as="geometry"/></mxCell><mxCell id="b6" value="6. RECURSOS CLAVE&#10;&#10;Base de datos (nucleo)&#10;Infraestructura cloud&#10;Equipo de desarrollo&#10;Catalogo de items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E05C5C;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="280" width="220" height="220" as="geometry"/></mxCell><mxCell id="b1" value="1. PROPUESTA DE VALOR&#10;&#10;Visibilidad en tiempo real de las necesidades de cada albergue.&#10;&#10;Las donaciones llegan donde faltan, con trazabilidad completa donante - albergue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D94F6B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="220" height="440" as="geometry"/></mxCell><mxCell id="b4" value="4. RELACION CON CLIENTES&#10;&#10;Autoservicio:&#10;publicar necesidades,&#10;registrar donaciones,&#10;consultar destino,&#10;agendar turnos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B74;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="220" height="220" as="geometry"/></mxCell><mxCell id="b3" value="3. CANALES&#10;&#10;App web responsive&#10;(movil primero)&#10;Redes sociales y medios&#10;en cada emergencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="280" width="220" height="220" as="geometry"/></mxCell><mxCell id="b2" value="2. SEGMENTO DE CLIENTES&#10;&#10;Coordinadores de albergues&#10;(municipios, JJVV)&#10;Donantes&#10;(personas y empresas)&#10;Voluntarios&#10;Institucional: SENAPRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B5B95;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="220" height="440" as="geometry"/></mxCell><mxCell id="b9" value="9. ESTRUCTURA DE COSTOS&#10;&#10;Cloud (BD + hosting) | Desarrollo y mantencion | Soporte en emergencias | Bajo costo fijo: escala solo en catastrofes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3FA796;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="550" height="220" as="geometry"/></mxCell><mxCell id="b5" value="5. FUENTE DE INGRESOS&#10;&#10;Gratuita para donantes y albergues | Convenios municipales / SENAPRED por reporteria | Auspicios de empresas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E7CC3;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;verticalAlign=top;spacingTop=8;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="500" width="550" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>