{
  "expo": {
    "name": "Red Solidaria de Emergencias",
    "slug": "red-solidaria-emergencias",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2A52"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.redsolidaria.emergencias",
      "infoPlist": {
        "NSCameraUsageDescription": "La camara se usa para escanear los codigos QR de las donaciones al recibirlas.",
        "NSLocationWhenInUseUsageDescription": "La ubicacion permite mostrar los albergues cercanos en el mapa."
      }
    },
    "android": {
      "package": "cl.redsolidaria.emergencias",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2A52"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        { "cameraPermission": "La camara se usa para escanear codigos QR de donaciones." }
      ]
    ]
  }
}
