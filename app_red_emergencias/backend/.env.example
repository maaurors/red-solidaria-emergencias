# Copiar este archivo como .env y ajustar los valores
# NUNCA subir el .env real a un repositorio

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=red_emergencias

# Clave para firmar los tokens JWT. Generar una propia:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

PORT=3000

# Acceso con Google (SSO). Crear un OAuth Client ID de tipo Web en
# Google Cloud Console y pegarlo aqui. Vacio = boton de Google desactivado.
GOOGLE_CLIENT_ID=
